NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AUTOLOKATE_API_BASE_URL=https://autolokate-api-staging-2j5tqz76xa-el.a.run.app

# SEO API (`/v1/seo/*`) — set to true to skip all server SEO fetches (faster local dev if API unstable)
# SEO_API_DISABLED=true
# Backend entity_type strings (defaults: model, brand, dealer, company)
# NEXT_PUBLIC_SEO_ENTITY_MODEL=model
# NEXT_PUBLIC_SEO_ENTITY_BRAND=brand
# NEXT_PUBLIC_SEO_ENTITY_DEALER=dealer
# NEXT_PUBLIC_SEO_ENTITY_COMPANY=company
# Optional middleware: call GET /v1/seo/redirects/{path} (comma-separated path prefixes, or "/" for all)
# SEO_REDIRECT_LOOKUP=true
# SEO_REDIRECT_PREFIXES=/blog,/media

# Autolokate AI (car detail “Ask AI”) — uses OPENAI_API_KEY for the model API
# Billing / quota: https://platform.openai.com/account/billing
OPENAI_API_KEY=
# Dev only: skip ₹129 paywall in the browser (do not set in production)
# NEXT_PUBLIC_AI_ACCESS_BYPASS=1
# OPENAI_MODEL=gpt-4o-mini

# Stripe (test) — Dashboard → Developers → API keys
# Use the Secret key (sk_test_… / sk_live_). This powers server-side Checkout.
STRIPE_SECRET_KEY=
# Webhooks → endpoint → Signing secret (whsec_…). Used only by /api/payments/stripe/webhook.
# This is NOT the publishable key (pk_…).
STRIPE_WEBHOOK_SECRET=
# Optional: publishable key for Stripe.js / Elements. Redirect Checkout does not require it.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Razorpay (test) — Dashboard → API Keys
# Key ID starts with rzp_test_ or rzp_live_. Secret is a different string (no rzp_ prefix).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from Dashboard → Webhooks (optional until you expose a webhook route)
# RAZORPAY_WEBHOOK_SECRET=
# Same Key ID as RAZORPAY_KEY_ID for Razorpay.js Checkout on /book-expert (safe to expose in the browser).
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google Calendar (service account)
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
